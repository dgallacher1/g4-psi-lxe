# Geometry images with Geant4's built-in RayTracer.  No display needed: every
# view is written as a JPEG in the working directory.
#
#   ./xenonSim macros/vis.mac        batch: write the images, then exit
#   G4UI_USE_TCSH=1 ./xenonSim       same images, then a terminal session (no Qt/X needed)
#
# Files are named g4RayTracer.RayTracer_NNNN.jpeg, numbered in the order below
# (0000 = overview, 0001 = beam's eye, 0002 = outer vessel hidden, 0003 = plan view).
#
# Notes on the RayTracer:
#   * geometry only: it draws no trajectories (use the ROOT output for tracks);
#   * it ignores section/cutaway planes, so internals are shown by hiding volumes;
#   * every redraw is a full trace, so auto-refresh stays off and each view is
#     drawn explicitly with /vis/viewer/flush.
/run/initialize

/vis/open RayTracer
/vis/viewer/set/autoRefresh false
/vis/viewer/set/background white
/vis/viewer/set/projection perspective 10 deg
# Optional: image size in pixels.
#/vis/rayTracer/column 1000
#/vis/rayTracer/row 1000

# --- 0000: overview, from the -x side where the beam port is -----------------
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointVector -1 -0.6 0.4
/vis/drawVolume
/vis/viewer/flush                     # drawVolume alone does not trace while auto-refresh is off

# --- 0001: beam's eye view, looking along +x at the window stack -------------
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/flush

# --- 0002: outer vessel hidden: inner vessel, sleeve, flanges, Ti foil -------
/vis/geometry/set/visibility OuterWall   0 false
/vis/geometry/set/visibility OuterBottom 0 false
/vis/geometry/set/visibility OuterTop    0 false
/vis/geometry/set/visibility OuterStub   0 false
/vis/geometry/set/visibility OuterFlange 0 false
/vis/geometry/set/visibility AlWindow    0 false
/vis/viewer/set/viewpointVector -1 -0.6 0.4
/vis/viewer/flush

# --- 0003: plan view from +z with the top plates removed: planes, source, port
/vis/geometry/set/visibility InnerTop 0 false
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/viewpointVector 0 0 1
/vis/viewer/set/projection orthogonal      # no perspective: true x-y positions, to judge fit against the wall
/vis/viewer/flush

# Optional: print the volume tree (names, materials, masses) as text.
#/vis/ASCIITree/verbose 4
#/vis/drawTree

# Load the beam so /run/beamOn works in an interactive session.
/control/execute macros/beam.mac
