<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alpha source: a thin needle, 1 mm long, 50 um diameter (approximate, from the user).
  Stand-in, not CAD: the material and the active layer are PLACEHOLDERS (see below).

  The code extracts the logical volume "AlphaSourceLV" by name and places it inside the LXe at
  Geo::sourceX/Y/Z (GeometryParameters.hh), with no rotation: the GDML tube axis (local z) is the
  vessel axis (world z).  It also looks up "ActiveLayerLV" by name for the colouring, so keep both
  names.  The <setup>/<world> below only makes the file valid on its own.

  PLACEHOLDERS to replace when known:
    * needle material: G4_STAINLESS-STEEL
    * active layer: a 1 um gold sleeve on the outside of the needle (where an Am-241 deposit would
      sit); the real deposit, if any, goes here

  Material names use the G4_* NIST convention (resolved by G4NistManager).
-->
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

  <define/>
  <materials/>

  <solids>
    <!-- GDML tube 'z' is the FULL length (Geant4 halves it internally). -->
    <tube name="needleSolid" rmin="0"      rmax="0.025" z="1.0" deltaphi="360" aunit="deg" lunit="mm"/>
    <tube name="activeSolid" rmin="0.024"  rmax="0.025" z="1.0" deltaphi="360" aunit="deg" lunit="mm"/>
  </solids>

  <structure>
    <volume name="ActiveLayerLV">
      <materialref ref="G4_Au"/>
      <solidref ref="activeSolid"/>
    </volume>

    <volume name="AlphaSourceLV">
      <materialref ref="G4_STAINLESS-STEEL"/>
      <solidref ref="needleSolid"/>
      <physvol name="activePV">
        <volumeref ref="ActiveLayerLV"/>
        <position name="activePos" unit="mm" x="0" y="0" z="0"/>
      </physvol>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="AlphaSourceLV"/>
  </setup>
</gdml>
