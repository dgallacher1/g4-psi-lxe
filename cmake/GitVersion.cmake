# Writes <OUT> (a header with XENON_GIT_DESCRIBE) from the state of the git checkout in <SRC>.
# Run at every build by the git_version target in CMakeLists.txt; the file is only rewritten when the
# text changes, so nothing recompiles unless the commit (or the dirty flag) changed.
#   cmake -DSRC=<source dir> -DOUT=<header> -P GitVersion.cmake
execute_process(COMMAND git -C ${SRC} describe --always --dirty --abbrev=12
                OUTPUT_VARIABLE GIT_DESCRIBE OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE GIT_RESULT)
if(NOT GIT_RESULT EQUAL 0 OR GIT_DESCRIBE STREQUAL "")
  set(GIT_DESCRIBE "unknown")
endif()
set(CONTENT "// generated by cmake/GitVersion.cmake\n#define XENON_GIT_DESCRIBE \"${GIT_DESCRIBE}\"\n")
set(OLD "")
if(EXISTS ${OUT})
  file(READ ${OUT} OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
  get_filename_component(DIR ${OUT} DIRECTORY)
  file(MAKE_DIRECTORY ${DIR})
  file(WRITE ${OUT} "${CONTENT}")
endif()
